{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists())",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid && newData.child('players').child(auth.uid).exists()",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('hostId').val() === auth.uid) && (!data.exists() ? root.child('rooms').child($code).child('status').val() === 'lobby' : true)",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid','nickname','color','ready','isBot','connected','joinedAt']) && newData.child('uid').val() === $uid && newData.child('nickname').isString() && newData.child('nickname').val().length <= 18)"
          }
        },
        "hostId": {
          ".write": "auth != null && (data.val() === auth.uid || (!root.child('rooms').child($code).child('players').child(data.val()).child('connected').val() && root.child('rooms').child($code).child('players').child(auth.uid).child('connected').val()))"
        },
        "status": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        },
        "match": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        },
        "movement": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('hostId').val() === auth.uid)"
          }
        },
        "commands": {
          "$commandId": {
            ".write": "auth != null && ((!data.exists() && newData.child('actorId').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).child('connected').val() === true) || root.child('rooms').child($code).child('hostId').val() === auth.uid)"
          }
        },
        "$other": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        }
      }
    },
    "roomSecrets": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
        "roles": {
          ".read": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('hostId').val() === auth.uid)",
            ".validate": "newData.val() === 'Pirate' || newData.val() === 'Cursed Pirate'"
          }
        },
        "cursedTreasureId": {
          ".read": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        },
        "createdAt": {
          ".read": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        }
      }
    }
  }
}
